{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hackalem-local",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    "APP_URL": "http://localhost:3000",
    "VECTOR_SEARCH_ENABLED": "false",
  },
  "kv_namespaces": [{ "binding": "KV" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hackalem-local",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "hackalem-local-files" },
  ],
  // Vectorize has no local implementation. Add a remote dev binding to opt in.
  "env": {
    "production": {
      "name": "hackalem",
      "account_id": "08c87221ba19a69eecc91d626b73bdc0",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "hackalem.abzal.dev", "custom_domain": true }],
      "vars": {
        "APP_URL": "https://hackalem.abzal.dev",
        "VECTOR_SEARCH_ENABLED": "true",
      },
      "kv_namespaces": [
        { "binding": "KV", "id": "256ce801c97c4f3e933d9784a3299b81" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hackalem-db",
          "database_id": "304dbe99-62fa-4737-a251-ff1e8db100bf",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hackalem-files" }],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "hackalem-vectors",
          "remote": true,
        },
      ],
    },
  },
}
