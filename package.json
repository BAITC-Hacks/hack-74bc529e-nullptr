{
  "name": "hackalem",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "build:production": "CLOUDFLARE_ENV=production bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun --bun tsc --noEmit",
    "cf:typegen": "bun --bun wrangler types",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun wrangler d1 migrations apply DB --local",
    "db:migrate:production": "bun --bun wrangler d1 migrations apply DB --remote --env production",
    "cf": "bun --bun wrangler",
    "deploy:check": "bun scripts/check-production.ts",
    "deploy:dry-run": "bun run build:production && bun --bun wrangler deploy --dry-run --env production",
    "deploy": "bun run deploy:check && bun run build:production && bun run db:migrate:production && bun --bun wrangler deploy --env production",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "test": "bun test",
    "check": "bun run cf:typegen && bun run build && bun run typecheck && bun run test && bun run format:check",
    "test:smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.5.13",
    "@tanstack/ai": "^0.54.0",
    "@tanstack/ai-openai": "^0.22.6",
    "@tanstack/ai-react": "^0.24.1",
    "@tanstack/react-router": "^1.170.34",
    "@tanstack/react-start": "^1.168.51",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@tanstack/ai-client": "^0.31.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^5.20260908.0-alpha",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "undici": "7.29.0",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
